#!/usr/bin/env python3
import requests, time, datetime, json, sys, itertools
from bs4 import BeautifulSoup
import spacy
import networkx as nx

def fetch_recent_articles():
    url = "https://habr.com/ru/rss/all/"
    resp = requests.get(url)
    resp.raise_for_status()
    soup = BeautifulSoup(resp.content, 'xml')
    items = soup.find_all('item')
    articles=[]
    for item in items:
        link=item.link.text
        pubDate=datetime.datetime.strptime(item.pubDate.text,'%a, %d %b %Y %H:%M:%S %z')
        if datetime.datetime.now(pubDate.tzinfo)-pubDate<datetime.timedelta(days=1):
            articles.append(link)
    return articles

def fetch_article_text(url):
    r=requests.get(url)
    r.raise_for_status()
    soup=BeautifulSoup(r.content,'html.parser')
    article=soup.find('article')
    if not article:
        return ''
    texts=[p.get_text() for p in article.find_all('p')]
    return ' '.join(texts)

def extract_topics(text, nlp):
    doc=nlp(text)
    topics=set()
    for ent in doc.ents:
        if ent.label_ in ('ORG','PERSON','GPE','LOC'):
            topics.add(ent.text.lower())
    for chunk in doc.noun_chunks:
        topics.add(chunk.root.text.lower())
    return topics

def build_graph(articles, nlp):
    G=nx.Graph()
    start=time.time()
    for url in articles:
        try:
            text=fetch_article_text(url)
            topics=extract_topics(text,nlp)
            for t in topics:
                if not G.has_node(t):
                    G.add_node(t)
            for a,b in itertools.combinations(topics,2):
                if G.has_edge(a,b):
                    G[a][b]['weight']+=1
                else:
                    G.add_edge(a,b,weight=1)
        except Exception as e:
            print(f"Error processing {url}: {e}",file=sys.stderr)
    end=time.time()
    return G,start,end

def main():
    nlp=spacy.load('en_core_web_sm')
    articles=fetch_recent_articles()
    print(f"Found {len(articles)} recent articles")
    graph, t1,t2 = build_graph(articles,nlp)
    nx.write_gpickle(graph,'topics_graph.gpickle')
    print("Graph saved to topics_graph.gpickle")
    report={
        'total_articles':len(articles),
        'graph_nodes':graph.number_of_nodes(),
        'graph_edges':graph.number_of_edges(),
        'download_time_sec':t1,
        'nlp_time_sec':t2-t1
    }
    with open('performance_report.json','w') as f:
        json.dump(report,f,indent=2)
    print("Performance report written to performance_report.json")

if __name__=='__main__':
    main()
