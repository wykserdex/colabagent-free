from flask import Flask, request, render_template, redirect, url_for
import sqlite3

app = Flask(__name__)

def get_db():
    conn = sqlite3.connect('database.db')
    return conn

@app.route('/')
def index():
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT id, name FROM users")
    users = cur.fetchall()
    return render_template('index.html', users=users)

@app.route('/add', methods=['POST'])
def add_user():
    name = request.form['name']
    # Vulnerability: raw SQL string formatting
    conn = get_db()
    conn.execute(f"INSERT INTO users (name) VALUES ('{name}')"); # Vulnerability detected; write report
    with open('vuln_report.txt','w') as f:
        f.write("SQL Injection vulnerability in add_user route. Raw SQL string formatting used.")

    conn.commit()
    return redirect(url_for('index'))

if __name__ == '__main__':
    app.run(debug=True)
